# Optional public Minecraft server address shown on the site.
VITE_SERVER_ADDRESS=play.warnetwork.fun
# Optional: each mode's own address (host or host:port) so Lifesteal and Practice show their own exact player counts
VITE_LIFESTEAL_ADDRESS=
VITE_PRACTICE_ADDRESS=

# Optional read-only JSON endpoint returning { "online": true, "players": 12, "maxPlayers": 100, "version": "1.21.x" }.
# Leave unset to show STATUS UNAVAILABLE; the UI never invents player counts.
VITE_SERVER_STATUS_URL=

# Staff console password (server-side only; never use a VITE_ prefix).
WARNETWORK_STAFF_PASSWORD=change-this-to-a-long-private-password

# Optional private Discord staff-channel webhook URL. Keep server-side; never add a VITE_ prefix.
DISCORD_STAFF_WEBHOOK_URL=

# Discord OAuth2 for /account. Add this exact callback URL in the Discord Developer Portal.
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/auth/discord/callback

# Generate a long random token and set the same value in the Paper plugin configuration.
WN_PLUGIN_API_TOKEN=GENERATE_A_LONG_RANDOM_SECRET

# Optional: if the frontend is hosted separately from the Node API, set the API origin here.
# Example: https://api.yourdomain.com
VITE_API_BASE_URL=
# Required only when the Node API is hosted on a different origin than the frontend.
# Example: https://www.yourdomain.com
FRONTEND_ORIGIN=
